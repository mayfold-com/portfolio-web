{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "naimchayata.com/*", "zone_name": "naimchayata.com" },
		{ "pattern": "www.naimchayata.com/*", "zone_name": "naimchayata.com" }
	]
}
